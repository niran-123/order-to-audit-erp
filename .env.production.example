# ==============================================================================
# Order-to-Audit ERP - Production Environment Configuration Template
# For AWS EC2 / Cloud VM / Containerized Production Deployment
# Copy to .env.production and inject secure credentials before deployment
# ==============================================================================

# Node Environment
NODE_ENV=production

# Backend Service Port
PORT=5000

# PostgreSQL Production Credentials (CHANGE THESE IN REAL PRODUCTION!)
POSTGRES_USER=ordertoaudit_admin
POSTGRES_PASSWORD=ReplaceWithStrongAutoGeneratedPassword64Chars!
POSTGRES_DB=ordertoaudit_erp_prod
POSTGRES_PORT=5432

# Production Database Connection Pool (Configured for 20 connections & 30s timeout)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&connection_limit=20&pool_timeout=30

# Strict CORS Whitelist (Only allow your verified domain and SSL endpoints)
CORS_ORIGIN=https://erp.yourdomain.com,https://api.yourdomain.com

# Cryptographically Secure JWT Secret (Generate with: openssl rand -base64 48)
JWT_SECRET=DO_NOT_USE_DEFAULT_GENERATE_RANDOM_KEY_AT_LEAST_64_CHARS_LONG
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging Level (Use 'info' or 'warn' in production to minimize log overhead)
LOG_LEVEL=info

# Optional Sentry / Error Monitoring DSN
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional Automated Backup S3 Bucket
# S3_BACKUP_BUCKET=s3://ordertoaudit-backups-prod
