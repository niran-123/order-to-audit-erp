# ==============================================================================
# Order-to-Audit ERP - Global Environment Configuration (.env.example)
# Copy this file to .env before starting services with Docker Compose
# ==============================================================================

# Node Environment: development | test | production
NODE_ENV=development

# Backend API Port
PORT=5000

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ordertoaudit_erp
POSTGRES_PORT=5432

# Backend Database Connection String (Direct or Docker Container)
# For local host development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ordertoaudit_erp?schema=public
# For docker-compose network:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ordertoaudit_erp?schema=public

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# Cryptographic JWT Authentication Secret (Minimum 32 random characters in production)
JWT_SECRET=dev_order_to_audit_jwt_secret_key_2026_dev_only
JWT_EXPIRES_IN=8h

# Logging Level: error | warn | info | http | debug
LOG_LEVEL=debug

# Frontend Vite Configuration
VITE_API_URL=http://localhost:5000/api/v1
